# Environment Variables — Maharashtra Flood Prediction System
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# ──────────────────────────────────────────────────
# DATABASE SETTINGS (PostgreSQL + PostGIS)
# ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maharashtra_flood_db
DB_USER=flood_user
DB_PASSWORD=your_secure_password_here

# ──────────────────────────────────────────────────
# APPLICATION SETTINGS
# ──────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your_secret_key_here_change_in_production
API_PORT=8000

# ──────────────────────────────────────────────────
# EXTERNAL DATA APIs
# ──────────────────────────────────────────────────

# India Meteorological Department (IMD)
# Register at: https://mausam.imd.gov.in
IMD_API_URL=https://api.imd.gov.in/
IMD_API_KEY=your_imd_api_key_here

# Central Water Commission (CWC) Real-Time Data
# Register at: http://www.cwc.gov.in
CWC_API_URL=http://cwc.gov.in/api/
CWC_API_KEY=your_cwc_api_key_here

# Open-Meteo (FREE — no API key required)
# Documentation: https://open-meteo.com/en/docs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ──────────────────────────────────────────────────
# ALERT CHANNELS (optional)
# ──────────────────────────────────────────────────

# Email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password_here
ALERT_EMAIL_TO=recipients@example.com

# SMS alerts (e.g., Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
ALERT_SMS_TO=+919876543210

# Webhook for external systems
ALERT_WEBHOOK_URL=https://hooks.example.com/flood-alert
